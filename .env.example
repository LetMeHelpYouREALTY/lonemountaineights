# Cloudflare Images Configuration
# Get your Account Hash from: Cloudflare Dashboard > Images > Overview
NEXT_PUBLIC_CF_ACCOUNT_HASH=<your-account-hash>

# Set to "true" to serve images from Cloudflare CDN; "false" uses local /public/images/
NEXT_PUBLIC_CF_IMAGES_ENABLED=true

# API Token — only used by scripts/upload-to-cloudflare.js (NOT exposed to browser)
# Create at: Cloudflare Dashboard > My Profile > API Tokens > Create Token > Cloudflare Images:Edit
CF_ACCOUNT_ID=<your-account-id>
CF_API_TOKEN=<your-api-token>

# Google Maps Platform (Maps JavaScript API + Places) — browser key, restrict by HTTP referrer in Google Cloud
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Map ID for Advanced Markers styling (works without it)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
